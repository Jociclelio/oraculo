# Open WebUI — chave secreta (persistência de tokens OAuth/MCP)
# Gerar com: openssl rand -hex 32
WEBUI_SECRET_KEY=

# Open Terminal — autenticação da API (deve bater com TERMINAL_SERVER_CONNECTIONS)
# Gerar com: openssl rand -hex 32
OPEN_TERMINAL_API_KEY=

# OpenWA — WhatsApp API Gateway
MCP_ENABLED=true
MCP_READONLY=false

# 9Router — proxy de roteamento para providers cloud (fallback de LLM)
# JWT_SECRET/API_KEY_SECRET/MACHINE_ID_SALT: gerar com openssl rand -hex 32
# INITIAL_PASSWORD: senha do dashboard em :20128 (NÃO usar o default `123456`)
JWT_SECRET=
INITIAL_PASSWORD=
API_KEY_SECRET=
MACHINE_ID_SALT=

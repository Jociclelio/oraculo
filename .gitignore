# Modelos GGUF (arquivos grandes)
models/*
!models/*.ini
!models/*.md
!models/.gitkeep

# Dependências e caches
.opencode/
.pi/

# Arquivos de ambiente (opcional - descomente se quiser ignorar)
# .env

# Arquivos de ambiente e config com segredos
.env
data/searxng/settings.yml

# llama-swap (binário local e logs de runtime)
bin/*
!bin/dashboard.sh
!bin/hermes-gate.sh
!bin/hermes-gate.service
logs/

# grafo de conhecimento compartilhado (opencode <-> Open WebUI)
mcp-data/

# estado dos serviços docker (webui.db, uploads, sessões WhatsApp, caches)
data/

# comfyui — runtime (saídas, uploads, perfil, custom nodes da imagem)
comfyui/output/
comfyui/input/
comfyui/user/
comfyui/custom_nodes/

# comfyui — script default criado pelo entrypoint da imagem
comfyui/user-scripts/set-proxy.sh
